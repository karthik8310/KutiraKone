<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3ED">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creative Fabric Ideas ✨"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <!-- CARD 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginTop="20dp"
            android:elevation="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/cotton"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eco Tote Bags"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#222222"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Convert cotton scraps into reusable shopping bags."
                android:textColor="#666666"
                android:textSize="16sp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- CARD 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginTop="18dp"
            android:elevation="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/silk"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silk Cushion Covers"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#222222"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use silk leftovers for premium home decor."
                android:textColor="#666666"
                android:textSize="16sp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>